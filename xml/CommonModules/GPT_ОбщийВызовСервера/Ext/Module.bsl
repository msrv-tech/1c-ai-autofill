// Клиентская обёртка для серверных функций: определение конфигурации и проверка готовности настроек.

#Область ПрограммныйИнтерфейс

// Описание:
// Определяет, является ли база конфигурацией «Управление небольшой фирмой».
//
// Возвращаемое значение:
//  Булево - Истина, если конфигурация УНФ.
//
Функция ЭтоУНФ() Экспорт
	Возврат GPT_ОбщийМодульСервер.ЭтоУНФ();
КонецФункции

// Описание:
// Определяет, является ли база конфигурацией «Розница».
//
// Возвращаемое значение:
//  Булево - Истина, если конфигурация Розница.
//
Функция ЭтоРозница() Экспорт
	Возврат GPT_ОбщийМодульСервер.ЭтоРозница();
КонецФункции

// Описание:
// Возвращает состояние настроек расширения (готовность к работе).
//
// Возвращаемое значение:
//  Структура - с ключами:
//    * Готово - Булево - токен и адрес сервера заполнены;
//    * ТокенЗаполнен - Булево;
//    * АдресСервераЗаполнен - Булево.
//
Функция GPT_СостояниеНастроек() Экспорт
	
	Настройки = GPT_ОбщийМодульСервер.НастройкаПоУмолчанию();
	
	ТокенЗаполнен = ЗначениеЗаполнено(Настройки.Токен);
	АдресСервераЗаполнен = ЗначениеЗаполнено(Настройки.АдресСервера);
	
	Возврат Новый Структура(
		"Готово,ТокенЗаполнен,АдресСервераЗаполнен",
		ТокенЗаполнен И АдресСервераЗаполнен,
		ТокенЗаполнен,
		АдресСервераЗаполнен
	);

КонецФункции

#КонецОбласти
