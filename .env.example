# Строка подключения к информационной базе 1С
# Используется скриптом automation/update-extension-and-run-db.ps1
#
# Файловая база:
1C_CONNECTION_STRING=File="D:\path\to\your\base";Usr="Администратор";Pwd=
#
# Серверная база (пример):
# 1C_CONNECTION_STRING=Srvr="server";Ref="base";Usr="user";Pwd="password";

# Путь к 1cv8.exe (Designer/Enterprise)
1C_PLATFORM_EXE=C:\Program Files\1cv8\8.5.1.1150\bin\1cv8.exe
